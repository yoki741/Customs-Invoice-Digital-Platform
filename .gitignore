# 输出目录
输出/
输出测试/
自定义输出/

# 可执行文件和压缩包
*.exe
*.zip

# Python缓存
__pycache__/
*.pyc

# 临时文件
~$*

# 示例目录（太大）
柬埔寨清关例子/

# PyInstaller构建文件
build/
dist/
*.spec

# Web 平台运行数据（数据库 / 上传源文件 / 导出结果 / 日志）
data/
logs/

# 前端构建依赖
webapp/static_src/node_modules/
webapp/static/vendor/univer.js
webapp/static/vendor/univer.css
webapp/static/vendor/assets/

# 虚拟环境
.venv/
venv/

# 业务数据与调试产物（不入库）
screenshots/
*.xlsx
!模板文件/*.xlsx
tests/_*.py
webapp/static_src/e2e_*.mjs
